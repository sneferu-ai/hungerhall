; Engine configuration file.
; HUNGERHALL — G6 Prototype Spec pins (§1 Engine choice, binding):
;   main scene res://main.tscn · exactly one autoload SessionStateMachine ·
;   60 Hz physics · gl_compatibility · 640×360 base viewport → 1280×720 window ·
;   canvas_items stretch, keep aspect · full §15 InputMap including
;   sneferu_primary_action (physical Space) for the machine journey contract.
config_version=5

[application]

config/name="HUNGERHALL"
config/description="One building. One diet. Twenty-four floors. A single-player arcade dungeon crawl where your health bar is the only clock."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0431373, 0.0392157, 0.0745098, 1)

[autoload]

SessionStateMachine="*res://app/session_state_machine.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

common/drop_mouse_on_gui_input_disabled=true

